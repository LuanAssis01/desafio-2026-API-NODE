        {
          "name": "POST /api/species",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns created species', function () {",
                  "  pm.expect(body.species.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.species.category).to.eql('peixe');",
                  "});",
                  "",
                  "pm.test('stores GBIF external data', function () {",
                  "  pm.expect(body.species.externalData).to.be.an('object');",
                  "  pm.expect(body.species.externalData.provider).to.eql('GBIF');",
                  "  pm.expect(body.species.externalData.data.match.scientificName).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.species.externalData.data.occurrence.totalRecords).to.be.a('number');",
                  "});",
                  "",
                  "pm.collectionVariables.set('speciesId', body.species.id);"
                ]
              }
            }
          ],
