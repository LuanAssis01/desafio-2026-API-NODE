            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns user and token', function () {",
                  "  pm.expect(body.user).to.be.an('object');",
                  "  pm.expect(body.user.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.collectionVariables.set('userId', body.user.id);"
