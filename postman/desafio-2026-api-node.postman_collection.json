  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('password')) {",
          "  pm.collectionVariables.set('password', '12345678');",
          "}",
          "",
          "if (!pm.collectionVariables.get('userName')) {",
          "  pm.collectionVariables.set('userName', 'Luan');",
          "}",
          "",
          "if (!pm.collectionVariables.get('gbifScientificName')) {",
          "  pm.collectionVariables.set('gbifScientificName', 'Oreochromis niloticus');",
          "}",
          "",
          "if (!pm.collectionVariables.get('gbifUserAgent')) {",
          "  pm.collectionVariables.set('gbifUserAgent', 'desafio-2026-api-node/1.0');",
          "}"
        ]
      }
    }
  ],
