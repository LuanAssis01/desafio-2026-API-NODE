    {
      "name": "GBIF",
      "item": [
        {
          "name": "GET /species/match",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const taxonKey = body.usageKey || body.acceptedUsageKey || body.speciesKey;",
                  "",
                  "pm.test('matches scientific name in GBIF', function () {",
                  "  pm.expect(taxonKey).to.be.a('number');",
                  "  pm.expect(body.scientificName).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.matchType).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.collectionVariables.set('gbifTaxonKey', String(taxonKey));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "User-Agent",
                "value": "{{gbifUserAgent}}"
              }
            ],
            "url": {
              "raw": "{{gbifBaseUrl}}/species/match?name={{gbifScientificName}}&verbose=true",
              "host": [
                "{{gbifBaseUrl}}"
              ],
              "path": [
                "species",
                "match"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "{{gbifScientificName}}"
                },
                {
                  "key": "verbose",
                  "value": "true"
                }
              ]
            }
          },
          "response": []
        },
