generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  name         String?
  email        String    @unique
  passwordHash String
  species      Species[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Species {
  id             String   @id @default(uuid())
  commonName     String
  scientificName String
  category       String
  latitude       Float
  longitude      Float
  recordedAt     DateTime
  externalData   Json?
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([commonName])
  @@index([scientificName])
  @@map("species")
}
